# Campmatch Production Environment Configuration
# Copy to .env and fill in your actual values

# === Security ===
SECRET_KEY=change-this-to-a-strong-random-secret-key-at-least-32-chars
ENV=production

# === Database ===
# For SQLite (single node): DATABASE_URL=sqlite:////data/campmatch.db
# For PostgreSQL (production): DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:////data/campmatch.db

# === Data Directories ===
DATA_DIR=/data
UPLOAD_DIR=/data/uploads

# === Google OAuth ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# === Admin ===
ADMIN_EMAIL=admin@st.umat.edu.gh
ADMIN_PASSWORD=change-this-admin-password

# === CORS ===
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173

# === PWA / Install ===
CAMP_FLAG_pwa_install_prompt=true
CAMP_FLAG_spotlight_boost=true
CAMP_flag_new_swipe_ui=true

# === Feature Flags ===
CAMP_FLAG_ai_profile_assist=true
CAMP_FLAG_webhook_delivery=false
CAMP_FLAG_canary_payments=false
