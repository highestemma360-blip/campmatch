# Campmatch Production Environment Configuration
# Copy to .env and fill in your actual values. Never commit real secrets.

# === Security ===
SECRET_KEY=change-this-to-a-strong-random-secret-key-at-least-32-chars
ENV=production

# === Database ===
# For SQLite (single node): DATABASE_URL=sqlite:////data/campmatch.db
# For PostgreSQL (production): DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:////data/campmatch.db

# === Data Directories ===
DATA_DIR=/data
UPLOAD_DIR=/data/uploads

# === Public base URL (used for Moolre callbacks + redirects) ===
PUBLIC_BASE_URL=https://campmatch.onrender.com

# === CORS ===
ALLOWED_ORIGINS=https://campmatch.onrender.com,http://localhost:5173

# === Google OAuth (only approved school .edu.gh domains accepted; @gmail.com rejected) ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Vite exposes this to the frontend for Google sign-in
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# === Admin portal (/admin) ===
ADMIN_EMAIL=admin@st.umat.edu.gh
ADMIN_PASSWORD=change-this-admin-password

# === PWA / Install feature flags ===
CAMP_FLAG_pwa_install_prompt=true
CAMP_FLAG_spotlight_boost=true
CAMP_FLAG_ai_profile_assist=true

# === Feature Flags ===
CAMP_FLAG_webhook_delivery=false
CAMP_FLAG_canary_payments=false

# === Moolre payments (MTN MoMo / Telecel Cash / AT Money Ghana) ===
MOOLRE_ENV=live
MOOLRE_USER=your-moolre-user
MOOLRE_PUBKEY=your-moolre-pubkey
MOOLRE_ACCOUNT_NUMBER=your-moolre-account-number
MOOLRE_WALLET_SECRET=your-moolre-wallet-secret
MOOLRE_MERCHANT_EMAIL=merchant@campmatch.edu.gh
MOOLRE_CALLBACK_URL=https://campmatch.onrender.com/api/payments/webhook

# === AI assistant (NVIDIA NIM default; any OpenAI-compatible provider) ===
AI_API_KEY=your-nvidia-api-key
AI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# === Web push (VAPID) ===
# Optional — keys are auto-generated and persisted on disk if left empty.
# Set VAPID_SUBJECT to a mailto: or https: URL.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=https://campmatch.onrender.com
